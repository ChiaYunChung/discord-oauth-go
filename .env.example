# 複製這份檔案為 .env 並填入實際值。
# .env 已加入 .gitignore，不會被提交進版控。

# 這三個對應「本服務」在 Discord Developer Portal 註冊的 OAuth App：
# https://discord.com/developers/applications -> 建立 Application -> OAuth2

# OAuth2 頁面上的 Client ID
DISCORD_CLIENT_ID=

# OAuth2 頁面上的 Client Secret
DISCORD_CLIENT_SECRET=

# 必須跟 Discord OAuth2 頁面的 Redirects 清單裡設定的其中一個完全一致
# 本機測試可用 http://localhost:8080/callback
DISCORD_REDIRECT_URI=http://localhost:8080/callback

# 選填：config.yaml 的路徑，預設是執行目錄下的 config.yaml
# CONFIG_PATH=config.yaml
